# ---------- BLIP (local, Hugging Face) ----------
BLIP_MODEL=Salesforce/blip-image-captioning-large
# Lighter: Salesforce/blip-image-captioning-base   | Heavier: Salesforce/blip2-opt-2.7b
BLIP_DEVICE=auto                 # auto | cpu | cuda | mps
BLIP_FP16=true                   # only applied on CUDA
BLIP_BATCH_SIZE=16               # lower to 4-8 on CPU / small GPU
BLIP_NUM_BEAMS=3
BLIP_MAX_NEW_TOKENS=30
BLIP_PROMPT=                     # optional conditional prefix, e.g. "a video frame of"

# ---------- Frame sampling ----------
SAMPLING_MODE=hybrid             # uniform | scene | hybrid
SAMPLE_EVERY_SEC=1.0             # uniform step (also max gap in hybrid mode)
SCENE_THRESHOLD=27.0             # PySceneDetect ContentDetector threshold
MAX_FRAMES=300                   # hard cap per video
FRAME_MAX_SIDE=512               # downscale frames before BLIP

# ---------- Segmenting / merging ----------
SEGMENT_MIN_SEC=2.0
SEGMENT_MAX_SEC=8.0
DEDUPE_SIMILARITY=90             # rapidfuzz ratio (0-100) above which neighbouring captions merge
CAPTION_LANGUAGE=en              # en | ar | ...

# ---------- Ollama Cloud ----------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
# Text-only merge/summarize model (fast, strong writer)
OLLAMA_TEXT_MODEL=gpt-oss:120b
# Vision model, used only for the optional "refine with keyframes" mode (confirmed vision-capable)
OLLAMA_VISION_MODEL=gemma4:31b
REFINE_WITH_VISION=false         # true = send 1-3 keyframes per segment to the vision model
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONCURRENCY=4

# ---------- Output ----------
OUTPUT_DIR=./outputs
CAPTION_FONT_SIZE=28
CAPTION_POSITION=bottom          # bottom | top
BURN_IN=true                     # hard-burn captions into the video
ALSO_SOFT_SUBS=true              # additionally embed a toggleable subtitle track
